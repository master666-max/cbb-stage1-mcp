# local runtime artifacts — never commit
# NOTE: patterns are root-anchored on purpose. A bare ``box/`` also matches
# ``src/cbb_stage1/box/`` (the box builder package), which silently excluded a
# whole source package from the export. Keep the leading slash.
/.venv/
/.pytest_cache/
__pycache__/
*.pyc
/artifacts/
/work/
/box/
/out-box/
*.egg-info/
dist/
