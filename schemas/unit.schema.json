{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cbb-box/2/unit.schema.json",
  "title": "Unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit_id", "book_id", "volume", "chapter", "title", "order", "text_path", "chars", "sha256", "narrative_mode", "source_locator"],
  "properties": {
    "unit_id": {"type": "string", "pattern": "^u:[a-z0-9_-]+:v[0-9]{2}:c[0-9]{3}(:s[0-9]{2})?$"},
    "book_id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "volume": {"type": "integer", "minimum": 1},
    "chapter": {"type": "integer", "minimum": 1},
    "title": {"type": "string"},
    "order": {"type": "integer", "minimum": 1},
    "prev": {"type": ["string", "null"]},
    "next": {"type": ["string", "null"]},
    "text_path": {"type": "string"},
    "chars": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "narrative_mode": {"enum": ["present", "flashback", "prophecy", "mixed"]},
    "narrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["first_person", "third_person", "third_limited", "unknown"]},
        "entity_id": {"type": ["string", "null"], "pattern": "^e:"},
        "name": {"type": ["string", "null"]}
      }
    },
    "narrator_reliability": {"enum": ["reliable", "unreliable", "unknown"]},
    "source_locator": {
      "type": "object",
      "additionalProperties": true,
      "required": ["href", "nav_index"],
      "properties": {
        "href": {"type": "string"},
        "nav_index": {"type": "integer", "minimum": 0}
      }
    },
    "scenes": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
