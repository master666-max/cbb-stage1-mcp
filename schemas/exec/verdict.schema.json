{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cbb-exec/verdict.schema.json",
  "title": "Verifier verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "verdict_id", "assertion_id", "unit_id", "verdict", "evidence", "confidence", "verifier", "created_at"],
  "properties": {
    "contract": {"const": "cbb-verdict/1"},
    "verdict_id": {"type": "string", "minLength": 3},
    "assertion_id": {"type": "string", "pattern": "^a:"},
    "unit_id": {"type": "string", "pattern": "^u:"},
    "verdict": {"enum": ["support", "against", "unsure"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote", "span", "quote_sha256"],
        "properties": {
          "quote": {"type": "string", "minLength": 1},
          "span": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2},
          "quote_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model", "context_mode"],
      "properties": {
        "name": {"type": "string"},
        "model": {"type": "string"},
        "context_mode": {"enum": ["isolated_source", "isolated_claimed_only"]}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
