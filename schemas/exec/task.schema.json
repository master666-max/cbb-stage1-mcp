{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cbb-exec/task.schema.json",
  "title": "Orchestrator task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "role", "unit_id", "inputs", "output", "budget_tokens", "attempts", "state"],
  "properties": {
    "task_id": {"type": "string", "minLength": 3},
    "role": {"enum": ["extractor", "verifier", "resolver", "arbiter", "abducer", "summarizer"]},
    "unit_id": {"type": ["string", "null"], "pattern": "^u:"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card", "card_sha256"],
      "properties": {
        "card": {"type": "string"},
        "card_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "assertion_id": {"type": "string", "pattern": "^a:"}
      }
    },
    "output": {"type": "string"},
    "budget_tokens": {"type": "integer", "minimum": 1},
    "attempts": {"type": "integer", "minimum": 0},
    "state": {"enum": ["pending", "running", "done", "error", "abstain", "dead_letter"]}
  }
}
