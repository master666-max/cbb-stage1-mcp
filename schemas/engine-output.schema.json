{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cbb-engine-output/1.schema.json",
  "title": "EngineOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "unit_id", "engine", "mentions", "entities", "assertions", "events", "cues", "summary", "abstain", "notes"],
  "properties": {
    "contract": {"const": "cbb-engine-output/1"},
    "gleaning_round": {"type": "integer", "minimum": 0},    "unit_id": {"type": "string", "pattern": "^u:"},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "model"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "model": {"type": "string"}
      }
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "span", "sentence_span", "sentence", "hint_type", "hint_alias_of"],
        "properties": {
          "surface": {"type": "string", "minLength": 1},
          "span": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2},
          "sentence_span": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2},
          "sentence": {"type": "string"},
          "hint_type": {"type": ["string", "null"]},
          "hint_alias_of": {"type": ["string", "null"]}
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["temp_id", "name", "type", "aliases", "description", "description_quote", "tier_hint"],
        "properties": {
          "temp_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "type": {"type": ["string", "null"]},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "description": {"type": ["string", "null"]},
          "description_quote": {"type": ["string", "null"]},
          "tier_hint": {"enum": ["canonical", "major", "minor", null]}
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "predicate", "object", "evidence", "confidence", "inferred"],
        "properties": {
          "subject": {"type": "string", "minLength": 1},
          "predicate": {"type": "string", "minLength": 1},
          "object": {
            "type": "object",
            "additionalProperties": false,
            "required": ["literal"],
            "properties": {
              "literal": {"type": "string"},
              "entity": {"type": "string"},
              "datatype": {"enum": ["string", "number", "time", "boolean"]}
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["quote", "span"],
              "properties": {
                "quote": {"type": "string"},
                "span": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2},
                "speaker": {"type": ["object", "null"]},
                "mode": {"enum": ["narration", "dialogue", "inner", "memory", "document", "letter"]}
              }
            }
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence_method": {"type": ["string", "null"]},
          "claim_layer": {"enum": ["fact", "statement", "inferred"]},
          "speaker": {"type": ["object", "null"]},
          "inferred": {"type": "boolean"}
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["temp_id", "type", "summary", "participants", "evidence"],
        "properties": {
          "temp_id": {"type": "string"},
          "type": {"type": "string"},
          "summary": {"type": "string"},
          "participants": {"type": "array", "items": {"type": "string"}},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["quote", "span"],
              "properties": {
                "quote": {"type": "string"},
                "span": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2}
              }
            }
          }
        }
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "subject_literal", "setup_quote", "expected", "confidence"],
        "properties": {
          "kind": {"enum": ["object", "line", "anomaly", "prophecy", "relationship"]},
          "subject_literal": {"type": "string"},
          "setup_quote": {"type": "string"},
          "expected": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "summary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["text", "evidence"],
      "properties": {
        "text": {"type": "string"},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["quote", "span"],
            "properties": {
              "quote": {"type": "string"},
              "span": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2}
            }
          }
        }
      }
    },
    "abstain": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {"enum": ["no_text", "too_long", "ambiguous", "schema_failed", "policy_refused"]}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
