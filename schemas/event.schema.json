{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cbb-box/2/event.schema.json",
  "title": "Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "book_id", "type", "summary", "participants", "location", "time", "importance", "unit_id", "evidence", "status", "deps", "produced_by"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^ev:[0-9a-f]{16,64}$"},
    "book_id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "type": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "participants": {"type": "array", "items": {"type": "string", "pattern": "^e:"}, "minItems": 1},
    "location": {"type": ["string", "null"], "pattern": "^e:"},
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_unit", "expression", "story_time", "constraints"],
      "properties": {
        "anchor_unit": {"type": ["string", "null"], "pattern": "^u:"},
        "expression": {"type": ["string", "null"]},
        "time_expr": {"type": ["string", "null"]},
        "story_time": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "start": {"type": ["string", "null"]},
            "end": {"type": ["string", "null"]},
            "precision": {"enum": ["day", "month", "year", "decade", "unknown"]}
          }
        },
        "constraints": {"type": "array", "items": {"type": "string", "pattern": "^t:"}}
      }
    },
    "importance": {"enum": ["high", "medium", "low"]},
    "unit_id": {"type": "string", "pattern": "^u:"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit_id", "start", "end", "quote", "quote_sha256", "occurrence"],
        "properties": {
          "unit_id": {"type": "string", "pattern": "^u:"},
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 0},
          "quote": {"type": "string", "minLength": 1},
          "quote_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "occurrence": {"type": "integer", "minimum": 1},
          "speaker": {"type": ["object", "null"]},
          "mode": {"enum": ["narration", "dialogue", "inner", "memory", "document", "letter"]}
        }
      }
    },
    "status": {"enum": ["asserted", "inferred", "disputed", "retracted", "superseded"]},
    "superseded_by": {"type": ["string", "null"], "pattern": "^ev:"},
    "deps": {"type": "array", "items": {"type": "string"}},
    "produced_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "engine", "prompt_sha256"],
      "properties": {
        "run_id": {"type": "string"},
        "engine": {"type": "string"},
        "prompt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
